{
  "name": "buddy-remote-test",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buddy",
      "database_id": "c0507c5b-121a-465f-afe1-d0b046edb5ca",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REMOTE_STATE", "class_name": "RemoteState" },
      { "name": "CARE_STATE", "class_name": "CareState" }
    ]
  },
  "exports": {
    "RemoteState": { "type": "durable-object", "storage": "sqlite" },
    "CareState": { "type": "durable-object", "storage": "sqlite" }
  }
}
